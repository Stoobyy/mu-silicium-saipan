+ */
+static uint32_t gic_intid_vtimer = 27;
+static bool gic_vtimer_from_bootarg;    /* (then the timer is the kernel's alone, and goes quiet on the way back) */
+#define GIC_INTID_VTIMER        gic_intid_vtimer
